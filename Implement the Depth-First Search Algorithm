def dfs(adj_matrix, start):
    n = len(adj_matrix)
    visited = [False] * n
    result = []
    stack = [start]
    
    while stack:
        node = stack.pop()
        if not visited[node]:
            visited[node] = True
            result.append(node)
            
            for neighbor in range(n - 1, -1, -1):
                if adj_matrix[node][neighbor] == 1 and not visited[neighbor]:
                    stack.append(neighbor)
    
    return result
