def dfs_n_queens(n):
    if n < 1:
        return []
    
    solutions = []
    
    def is_safe(board, row, col):
        for prev_row in range(row):
            prev_col = board[prev_row]
            if prev_col == col or abs(prev_col - col) == abs(prev_row - row):
                return False
        return True
    
    def dfs(board, row):
        if row == n:
            solutions.append(board[:])
            return
        
        for col in range(n):
            if is_safe(board, row, col):
                board.append(col)
                dfs(board, row + 1)
                board.pop()
    
    dfs([], 0)
    return solutions
